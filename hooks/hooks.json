{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/integrations/claude_code_hook.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/integrations/claude_code_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/integrations/claude_code_hook.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/integrations/claude_code_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
